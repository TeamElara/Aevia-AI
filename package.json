{
  "name": "aevia-ai",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch apps/gateway/src/server.ts",
    "start": "tsx apps/gateway/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "token": "tsx apps/gateway/scripts/token.ts",
    "setup:env": "tsx apps/gateway/scripts/setup-env.ts",
    "test:detectors": "vitest run packages/detectors/test",
    "test:access": "vitest run tests/security tests/integration",
    "seed": "node --import tsx apps/gateway/scripts/seed.ts",
    "benchmark": "node tests/security/benchmark.js",
    "eval:validate": "node eval/validate.mjs eval/dev.jsonl eval/heldout.jsonl eval/robustness.jsonl eval/live_subset.jsonl",
    "classifier:spike": "node tools/classifier-spike.mjs",
    "test:report": "WRITE_ACCESS_RESULTS=1 vitest run tests/security",
    "demo:access": "node --import tsx seed/run-access-demo.mjs",
    "demo:gateway": "node --import tsx seed/run-gateway-demo.ts",
    "verify:ollama": "tsx seed/verify-ollama.ts",
    "test:integration:report": "WRITE_GATEWAY_RESULTS=1 vitest run tests/integration",
    "typecheck:access": "tsc -p tsconfig.access.json"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "mongodb": "^6.20.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.3.0",
    "openai": "^7.34.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "@huggingface/transformers": "^4.3.1"
  },
  "overrides": {
    "vitest": "$vitest"
  }
}
