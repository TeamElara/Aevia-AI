HOST=127.0.0.1
PORT=8080
JWT_SECRET=GENERATE_ME
AUDIT_HMAC_SECRET=GENERATE_ME
FINGERPRINT_KEY=GENERATE_ME
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=aevia
LLM_PROVIDER=groq
GROQ_API_KEY=
# Set an available model from your Groq account; no hardcoded model lifecycle assumptions.
GROQ_MODEL=
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
POLICY_PATH=apps/gateway/policy.yaml
DETECTOR_MODULE=packages/detectors/src/index.ts
# Alwaz's modules are opt-in. Empty retrieval means prompt-only mode, never unrestricted RAG.
RETRIEVAL_MODULE=
APPROVALS_MODULE=
EVAL_MODE=false
# Passwordless seeded users are DEMO ONLY. Enable explicitly for the local console.
DEMO_AUTH=false
# Unprotected baseline: separate loopback-only synthetic evaluation process, never the demo server.
BASELINE_MODE=false
CORS_ORIGIN=http://localhost:5173
# [{"key":"a-random-key-at-least-32-characters","user":{"id":"asha","groups":["employee"]}}]
API_KEYS_JSON=[]
