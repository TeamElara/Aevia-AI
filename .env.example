# Generate each secret independently with: openssl rand -hex 32
JWT_SECRET=
FINGERPRINT_KEY=
MONGO_URL=mongodb://localhost:27017
# Team gateway provider configuration (not called by access tests)
GROQ_API_KEY=
GROQ_MODEL=

# Reference integration host: simulated by default; explicitly opt in to groq or ollama.
ACCESS_PROVIDER=simulated
OLLAMA_URL=http://127.0.0.1:11434/v1/
OLLAMA_MODEL=
