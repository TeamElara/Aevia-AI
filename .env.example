HOST=127.0.0.1
PORT=8080
JWT_SECRET=GENERATE_ME
AUDIT_HMAC_SECRET=GENERATE_ME
FINGERPRINT_KEY=GENERATE_ME
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=aevia
LLM_PROVIDER=groq
GROQ_API_KEY=
# Set an available model from your Groq account; no hardcoded model lifecycle assumptions.
GROQ_MODEL=
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
POLICY_PATH=apps/gateway/policy.yaml
DETECTOR_MODULE=packages/detectors/src/index.ts
CLASSIFIER_BACKEND=none
CLASSIFIER_CACHE_DIR=.cache/classifier
# Alwaz's modules are opt-in. Empty retrieval means prompt-only mode, never unrestricted RAG.
RETRIEVAL_MODULE=apps/gateway/src/retrieval/index.js
APPROVALS_MODULE=apps/gateway/src/approvals/index.js
EVAL_MODE=false
# Passwordless seeded users are DEMO ONLY. Enable explicitly for the local console.
DEMO_AUTH=false
# Unprotected baseline: separate loopback-only synthetic evaluation process, never the demo server.
BASELINE_MODE=false
# Human-review warnings for repeated risky requests. On by default when RETRIEVAL_MODULE is set
# (DB-backed identities); set false to turn off. Keep the hierarchy file matched to your users.
# SECURITY_ESCALATION_ENABLED=false
SECURITY_HIERARCHY_PATH=apps/gateway/security-hierarchy.json
CORS_ORIGIN=http://localhost:5173
# Cloud demo only: matching server-side credential on gateway and Vercel proxy.
# GATEWAY_PROXY_SECRET=
# SEED_DEMO_ON_START=false
# [{"key":"a-random-key-at-least-32-characters","user":{"id":"asha","groups":["employee"]}}]
API_KEYS_JSON=[]
