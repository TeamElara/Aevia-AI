    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Container shell; consumer sets internal padding.",
      "html": "<article class=\"ds-card\">Request details</article>",
      "css": ".ds-card{font-family:var(--font-sans);color:var(--color-fg);background:var(--color-surface);border:1px solid var(--color-line-2);border-radius:18px;box-shadow:var(--shadow);position:relative}.ds-card:after{content:\"\";position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;transition:opacity .4s;background:radial-gradient(300px circle at 50% 50%,color-mix(in srgb,var(--color-accent) 10%,transparent),transparent 60%)}.ds-card:hover:after{opacity:1}"
    },
