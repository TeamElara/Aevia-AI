  "narrative": {
    "northStar": "Warm Paper Console",
    "overview": "LeakShield combines a warm paper entrance with a working privacy gateway console. The shipped light theme uses beige surfaces, brown neutral accents, tightly spaced display typography, and a supplied robotic hand and butterfly image. Chat, Incidents, Overview, Approvals, and Eval remain the five navigable views. The dark console palette is preserved.\n\nThe entrance is balanced and spacious: equal desktop hero columns, centered mobile copy, and a centered message workspace. Rounded controls and quiet shadows soften the supplied mechanical subject. The photographic subject is separated into independently moving layers. PRODUCT.md records the approved refinement and existing product behavior from the web README and implemented views.",
    "keyCharacteristics": [
      "Warm paper and brown neutrals in light mode; preserved dark console surfaces.",
      "Balanced hero columns and centered mobile content without decorative rules.",
      "Tight sans-serif display type, readable body text, and monospace technical values.",
      "Functional semantic color for gateway verdicts.",
      "Slow subject motion and staggered entrances, with pause and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Neutral Atmosphere Rule",
        "body": "Keep the light page and hero ambient field warm beige; semantic verdict color belongs to functional status indicators and gateway content.",
        "section": "colors"
      },
      {
        "name": "The Motion Consent Rule",
        "body": "Keep the scene pause control and the global reduced-motion override when reusing the moving subject.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use warm paper, surface, and line roles for the light ambient canvas.",
      "Do preserve semantic labels alongside colored gateway verdicts.",
      "Do use balanced desktop hero columns and centered mobile copy and opening workspace.",
      "Do preserve pause, offscreen suspension, and reduced-motion behavior for the hero subject."
    ],
    "donts": [
      "Don't reintroduce purple or yellow ambient illumination to the hero or page background.",
      "Don't add decorative circuit lines, hero dividers, or asymmetric entrance layouts.",
      "Don't replace the supplied robotic hand and butterfly with an unrelated subject.",
      "Don't use the hero display size for operational tables or message content."
    ]
  }
