      "description": "Rounded centered entrance message field.",
      "html": "<div class=\"ds-field\"><textarea aria-label=\"Message\" placeholder=\"Message LeakShield\u2026\" rows=\"2\"></textarea></div>",
      "css": ".ds-field{padding:8px 8px 8px 20px;border:1px solid var(--color-line);border-radius:20px;box-shadow:0 8px 28px -18px #29272233;transition:box-shadow .3s var(--ease-soft),border-color .3s;background:var(--color-surface)}.ds-field:focus-within{outline:none;border-color:var(--color-accent);box-shadow:0 10px 32px -18px #29272255,0 0 0 2px var(--color-accent-soft)}.ds-field textarea{font-family:var(--font-sans);font-size:15.5px;line-height:1.625;color:var(--color-fg);background:transparent;border:0;padding:8px 0;resize:none;width:100%;caret-color:var(--color-fg)}.ds-field textarea:focus{outline:0}.ds-field textarea::placeholder{color:var(--color-faint)}"
